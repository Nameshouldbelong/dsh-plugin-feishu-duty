{
  "name": "@nameshouldbelong/dsh-feishu-duty",
  "description": "Feishu (Lark) duty gateway for DeepSeek Harness: long-connection Feishu events into a dedicated duty session, global approval forwarding while on duty, and a local/duty watch toggle.",
  "version": "0.1.0",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "feishu",
    "lark",
    "gateway",
    "bot",
    "agent",
    "approval"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nameshouldbelong/dsh-plugin-feishu-duty.git"
  },
  "bugs": {
    "url": "https://github.com/Nameshouldbelong/dsh-plugin-feishu-duty/issues"
  },
  "homepage": "https://github.com/Nameshouldbelong/dsh-plugin-feishu-duty#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.7 <0.3.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types-client/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.7-rc.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.7-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.7-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.3",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-rc.3",
    "@deepseek-ai/dsh-agent-presets": "0.1.5-rc.3",
    "@deepseek-ai/dsh-api-gateway": "0.1.5-rc.3",
    "@deepseek-ai/dsh-api-remotes": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.3",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.3",
    "@deepseek-ai/dsh-invariants": "0.1.5-rc.3",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.3",
    "@deepseek-ai/dsh-scope": "0.1.5-rc.3",
    "@deepseek-ai/dsh-session": "0.1.5-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.1.5-rc.3",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.3",
    "@deepseek-ai/dsh-tool-todo": "0.1.5-rc.3",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.3",
    "@deepseek-ai/dsh-user-approval": "0.1.5-rc.3",
    "@types/node": "^26.3.0",
    "@types/react": "~18.3.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsc -b tsconfig.client.json && tsdown --env.DSH_BUILD_FACE client",
    "typecheck": "tsc -b tsconfig.json --force && tsc -b tsconfig.client.json --force",
    "test": "node --test \"tests/*.test.ts\""
  }
}